# Copy this file to .env and fill in your real values. Never commit .env.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/career_companion

# GroqCloud API key (used for resume extraction, matching, and AI features)
# Create one at https://console.groq.com/keys and keep the real value only in .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI fallback. Leave these blank when using Groq.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Where uploaded resumes are stored on disk
UPLOAD_DIR=uploads

# Allowed origin for the frontend (Live Server default shown)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Secret used to sign login tokens (JWT) — set this to any long random
# string for real use. Everyone's existing login sessions break if you
# change this later, since old tokens won't verify against a new secret.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Optional: for database/fetch_adzuna_internships.py — pulls REAL, live
# internship postings (with real apply links) instead of the synthetic
# dataset. Free, instant signup, no card: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

